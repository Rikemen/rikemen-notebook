rules_version = '2';

// Assumed user-owned data model:
// - users/{uid}/notes/{noteId}: note metadata
// - users/{uid}/notes/{noteId}/chatThreads/{threadId}: AI chat thread metadata
// - users/{uid}/notes/{noteId}/chatThreads/{threadId}/messages/{messageId}: AI messages
// - users/{uid}/notes/{noteId}/whiteboardPages/{pageId}: whiteboard pages
// - users/{uid}/notes/{noteId}/workspace/{layoutId}: workspace layout
// - users/{uid}/notes/{noteId}/materials/{materialId}: PDF/image/bookmark metadata; file displayName is mutable
// - users/{uid}/notes/{noteId}/whiteboardDrawings/{drawingId}: drawing Storage metadata
// - users/{uid}/aiUsage/{date}: server-only quota records
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function ownsUserPath(userId) {
      return isOwner(userId);
    }

    function uidUnchanged(userId) {
      return request.resource.data.ownerUid == userId;
    }

    function uidNotModified() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function noteExists(userId, noteId) {
      return exists(/databases/$(database)/documents/users/$(userId)/notes/$(noteId));
    }

    function noteIsActive(userId, noteId) {
      return noteExists(userId, noteId)
        && !("deletionStatus" in get(
          /databases/$(database)/documents/users/$(userId)/notes/$(noteId)
        ).data);
    }

    function hasAllowedNoteFields() {
      return request.resource.data.keys().hasOnly([
        "createdAt",
        "favorite",
        "recent",
        "subject",
        "tags",
        "title",
        "updatedAt"
      ]);
    }

    function hasValidNoteShape() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 80
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 20
        && request.resource.data.favorite is bool
        && request.resource.data.recent is bool
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function hasValidChatThread(userId, noteId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "createdAt",
          "inheritedSummary",
          "noteId",
          "ownerUid",
          "sourceThreadId",
          "status",
          "title",
          "turnCount",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "createdAt",
          "noteId",
          "ownerUid",
          "status",
          "title",
          "turnCount",
          "updatedAt"
        ])
        && data.ownerUid == userId
        && data.noteId == noteId
        && data.status in ["active", "full", "summarizing", "archived"]
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.turnCount is int
        && data.turnCount >= 0
        && data.turnCount <= 30
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() <= 40
        && (!("inheritedSummary" in data)
          || (data.inheritedSummary is string && data.inheritedSummary.size() <= 4000))
        && (!("sourceThreadId" in data)
          || (data.sourceThreadId is string && data.sourceThreadId.size() <= 128));
    }

    function hasValidChatMessage(userId, noteId, threadId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "createdAt",
          "noteId",
          "ownerUid",
          "role",
          "text",
          "threadId"
        ])
        && data.keys().hasAll([
          "createdAt",
          "noteId",
          "ownerUid",
          "role",
          "text",
          "threadId"
        ])
        && data.ownerUid == userId
        && data.noteId == noteId
        && data.threadId == threadId
        && data.role in ["user", "assistant"]
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 4000
        && data.createdAt is string
        && data.createdAt.size() <= 40;
    }

    function hasValidMaterial(userId, noteId, materialId) {
      return hasValidLegacyPdfMaterial(userId, noteId, materialId)
        || hasValidFileMaterial(userId, noteId, materialId)
        || hasValidBookmarkMaterial(userId, noteId);
    }

    function hasValidMaterialBase(data, userId, noteId) {
      return uidUnchanged(userId)
        && data.ownerUid is string
        && data.ownerUid.size() > 0
        && data.ownerUid.size() <= 128
        && data.noteId == noteId
        && data.noteId is string
        && data.noteId.size() > 0
        && data.noteId.size() <= 128
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 40;
    }

    function hasValidMaterialDisplayName(data) {
      return !("displayName" in data)
        || (data.displayName is string
          && data.displayName.size() > 0
          && data.displayName.size() <= 120
          && data.displayName.matches("^[^\\n\\r\\t]+$"));
    }

    function hasValidFileValues(data, userId, noteId, materialId) {
      return hasValidMaterialBase(data, userId, noteId)
        && hasValidMaterialDisplayName(data)
        && data.contentType in ["application/pdf", "image/jpeg", "image/png"]
        && data.fileName is string
        && data.fileName.size() > 0
        && data.fileName.size() <= 240
        && data.sizeBytes is int
        && data.sizeBytes > 0
        && data.sizeBytes <= 5368709120
        && data.storagePath is string
        && data.storagePath.size() > 0
        && data.storagePath.size() <= 1024
        && data.storagePath.matches(
          "^users/" + userId + "/notes/" + noteId + "/materials/" + materialId + "/[^/]+$"
        );
    }

    function hasValidLegacyPdfMaterial(userId, noteId, materialId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "contentType",
          "createdAt",
          "displayName",
          "fileName",
          "noteId",
          "ownerUid",
          "pageCount",
          "sizeBytes",
          "storagePath"
        ])
        && data.keys().hasAll([
          "contentType",
          "createdAt",
          "fileName",
          "noteId",
          "ownerUid",
          "pageCount",
          "sizeBytes",
          "storagePath"
        ])
        && hasValidFileValues(data, userId, noteId, materialId)
        && data.contentType == "application/pdf"
        && data.pageCount is int
        && data.pageCount > 0
        && data.pageCount <= 100000;
    }

    function hasValidFileMaterial(userId, noteId, materialId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "contentType", "createdAt", "displayName", "fileName", "kind", "noteId", "ownerUid",
          "pageCount", "sizeBytes", "storagePath"
        ])
        && data.keys().hasAll([
          "contentType", "createdAt", "fileName", "kind", "noteId", "ownerUid",
          "sizeBytes", "storagePath"
        ])
        && hasValidFileValues(data, userId, noteId, materialId)
        && data.kind in ["pdf", "image"]
        && ((data.kind == "pdf"
            && data.contentType == "application/pdf"
            && data.pageCount is int
            && data.pageCount > 0
            && data.pageCount <= 100000)
          || (data.kind == "image"
            && data.contentType in ["image/jpeg", "image/png"]
            && !("pageCount" in data)));
    }

    function hasValidBookmarkMaterial(userId, noteId) {
      let data = request.resource.data;
      return data.keys().hasOnly(["createdAt", "kind", "noteId", "ownerUid", "title", "url"])
        && data.keys().hasAll(["createdAt", "kind", "noteId", "ownerUid", "title", "url"])
        && hasValidMaterialBase(data, userId, noteId)
        && data.kind == "bookmark"
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.url is string
        && data.url.size() > 0
        && data.url.size() <= 2048
        && data.url.matches("^https?://[^/@\\s]+([/?#][^\\s]*)?$");
    }

    function hasValidWhiteboardPage(userId, noteId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "createdAt", "markdown", "noteId", "ownerUid", "revision", "title", "updatedAt"
        ])
        && data.keys().hasAll([
          "createdAt", "markdown", "noteId", "ownerUid", "revision", "title", "updatedAt"
        ])
        && uidUnchanged(userId)
        && data.noteId == noteId
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.markdown is string
        && data.markdown.size() <= 200000
        && data.revision is int
        && data.revision >= 0
        && data.revision <= 2147483647
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 40;
    }

    function hasValidWhiteboardDrawing(userId, noteId, drawingId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "createdAt", "noteId", "ownerUid", "previewPath", "strokesPath", "updatedAt"
        ])
        && data.keys().hasAll([
          "createdAt", "noteId", "ownerUid", "previewPath", "strokesPath", "updatedAt"
        ])
        && uidUnchanged(userId)
        && data.noteId == noteId
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 40
        && data.previewPath == "users/" + userId + "/notes/" + noteId
          + "/whiteboardDrawings/" + drawingId + "/preview.png"
        && data.strokesPath == "users/" + userId + "/notes/" + noteId
          + "/whiteboardDrawings/" + drawingId + "/strokes.json";
    }

    function hasUnchangedWhiteboardPageIdentity() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.noteId == resource.data.noteId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasUnchangedWhiteboardDrawingIdentity() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.noteId == resource.data.noteId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasUnchangedMaterialIdentity() {
      return uidNotModified()
        && "displayName" in request.resource.data
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName"]);
    }

    match /users/{userId} {
      allow read, write: if ownsUserPath(userId);

      match /aiUsage/{date} {
        allow read, write: if false;
      }

      match /notes/{noteId} {
        allow read: if ownsUserPath(userId);
        allow delete: if false;
        allow create: if ownsUserPath(userId) && hasAllowedNoteFields() && hasValidNoteShape();
        allow update: if ownsUserPath(userId)
          && !("deletionStatus" in resource.data)
          && hasAllowedNoteFields()
          && hasValidNoteShape();

        match /chatThreads/{threadId} {
          allow read: if ownsUserPath(userId) && noteIsActive(userId, noteId);
          allow delete: if ownsUserPath(userId);
          allow create, update: if ownsUserPath(userId)
            && noteIsActive(userId, noteId)
            && hasValidChatThread(userId, noteId);

          match /messages/{messageId} {
            allow read: if ownsUserPath(userId) && noteIsActive(userId, noteId);
            allow delete: if ownsUserPath(userId);
            allow create, update: if ownsUserPath(userId)
              && noteIsActive(userId, noteId)
              && hasValidChatMessage(userId, noteId, threadId);
          }
        }

        match /whiteboardPages/{pageId} {
          allow read: if ownsUserPath(userId) && noteIsActive(userId, noteId);
          allow delete: if ownsUserPath(userId);
          allow create: if ownsUserPath(userId)
            && noteIsActive(userId, noteId)
            && hasValidWhiteboardPage(userId, noteId);
          allow update: if ownsUserPath(userId)
            && noteIsActive(userId, noteId)
            && hasValidWhiteboardPage(userId, noteId)
            && hasUnchangedWhiteboardPageIdentity();
        }

        match /whiteboardDrawings/{drawingId} {
          allow read: if ownsUserPath(userId) && noteIsActive(userId, noteId);
          allow delete: if ownsUserPath(userId);
          allow create: if ownsUserPath(userId)
            && noteIsActive(userId, noteId)
            && hasValidWhiteboardDrawing(userId, noteId, drawingId);
          allow update: if ownsUserPath(userId)
            && noteIsActive(userId, noteId)
            && hasValidWhiteboardDrawing(userId, noteId, drawingId)
            && hasUnchangedWhiteboardDrawingIdentity();
        }

        match /workspace/{layoutId} {
          allow read: if ownsUserPath(userId) && noteIsActive(userId, noteId);
          allow create, update: if ownsUserPath(userId) && noteIsActive(userId, noteId);
          allow delete: if ownsUserPath(userId);
        }

        match /materials/{materialId} {
          allow read: if ownsUserPath(userId) && noteIsActive(userId, noteId);
          allow create: if ownsUserPath(userId)
            && noteIsActive(userId, noteId)
            && hasValidMaterial(userId, noteId, materialId);
          allow update: if ownsUserPath(userId)
            && noteIsActive(userId, noteId)
            && hasValidMaterial(userId, noteId, materialId)
            && hasUnchangedMaterialIdentity();
          allow delete: if ownsUserPath(userId);
        }
      }

      match /textbooks/{textbookId} {
        allow read, write: if ownsUserPath(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
